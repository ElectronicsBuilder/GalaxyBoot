{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GalaxyBoot: build",
            "type": "shell",
            "command": "cmake --preset Debug; cmake --build --preset Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "absolute"
            }
        },
        {
            "label": "GalaxyBoot: clean build",
            "type": "shell",
            "command": "cmake --preset Debug; cmake --build --preset Debug --clean-first",
            "group": "build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "absolute"
            }
        },
        {
            "label": "GalaxyBoot: flash bootloader",
            "detail": "Galaxy F405 board over SWD, ST-LINK chosen by serial number; sectors 0-5; the application at 0x08040000 is kept",
            "type": "shell",
            "command": "C:/ST/STM32CubeCLT_1.16.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=SWD",
                "sn=${input:stlink}",
                "mode=UR",
                "-w",
                "build/Debug/GalaxyBoot.elf",
                "-v",
                "-rst"
            ],
            "dependsOn": "GalaxyBoot: build",
            "problemMatcher": []
        },
        {
            "label": "GalaxyBoot: build Release",
            "type": "shell",
            "detail": "-Os, no debug info: the build to run on the board",
            "command": "cmake --preset Release; cmake --build --preset Release",
            "group": "build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "absolute"
            }
        },
        {
            "label": "GalaxyBoot: flash bootloader (Release)",
            "detail": "Galaxy F405 board over SWD; sectors 0-5; the application at 0x08040000 is kept",
            "type": "shell",
            "command": "C:/ST/STM32CubeCLT_1.16.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=SWD",
                "sn=${input:stlink}",
                "mode=UR",
                "-w",
                "build/Release/GalaxyBoot.elf",
                "-v",
                "-rst"
            ],
            "dependsOn": "GalaxyBoot: build Release",
            "problemMatcher": []
        },
        {
            "label": "GalaxyBoot: reset",
            "type": "shell",
            "command": "C:/ST/STM32CubeCLT_1.16.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=SWD",
                "sn=${input:stlink}",
                "mode=HOTPLUG",
                "-rst"
            ],
            "problemMatcher": []
        },
        {
            "label": "host tests",
            "detail": "PC unit tests (sh tests/host/run_tests.sh) with Cygwin gcc",
            "type": "shell",
            "command": "C:/cygwin64/bin/bash.exe",
            "args": [
                "-lc",
                "cd \"$(cygpath '${workspaceFolder}')\" && sh tests/host/run_tests.sh"
            ],
            "group": "test",
            "problemMatcher": "$gcc"
        },
        {
            "label": "CI checks",
            "detail": "sh tools/ci_build.sh: clean build (no warnings in own code) + host tests",
            "type": "shell",
            "command": "C:/cygwin64/bin/bash.exe",
            "args": [
                "-lc",
                "cd \"$(cygpath '${workspaceFolder}')\" && PATH=\"$PATH:$(cygpath 'C:/ST/STM32CubeCLT_1.16.0/GNU-tools-for-STM32/bin'):$(cygpath 'C:/ST/STM32CubeCLT_1.16.0/CMake/bin'):$(cygpath 'C:/ST/STM32CubeCLT_1.16.0/Ninja/bin')\" sh tools/ci_build.sh"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "regenerate CubeMX code",
            "detail": "sh tools/cubemx_generate.sh . (USER CODE blocks, App/ and common/ are kept)",
            "type": "shell",
            "command": "sh tools/cubemx_generate.sh .",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "stlink",
            "type": "promptString",
            "description": "ST-LINK serial number",
            "default": "35FF76063446353935251757"
        }
    ]
}
